# CivicMind AI — Python inference service
APP_ENV=development
PORT=8000

# Optional read-only database mirror for duplicate detection
DATABASE_URL=postgresql+psycopg://user:password@host:5432/civicmind

# Model weights
VISION_MODEL_PATH=models/yolov8n-civic.pt
NLP_MODEL_NAME=xlm-roberta-base

# Allowed origins for the web app
CORS_ORIGINS=https://your-app.lovable.app
